PORT=3000
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_API_KEY=
ADMIN_TOKEN=
ADMIN_PASSWORD=
AGENTROUTER_CLIENT_PROFILE=codex
MAX_REQUEST_BYTES=20971520
UPSTREAM_WAF_RETRY=true
UPSTREAM_USER_AGENT=AetherEndpoint/1.0

# Supabase (required) — keys & credits are stored here.
# Run migrations/001_create_api_keys.sql in Supabase SQL editor first.
SUPABASE_URL=https://fuwyerrciwibgtvgxovp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional relay mode:
# AGENTROUTER_BASE_URL=https://agentrouter-relay.<your-subdomain>.workers.dev/v1
# AGENTROUTER_RELAY_KEY must equal the Cloudflare Worker RELAY_KEY secret.
AGENTROUTER_RELAY_KEY=

# Optional. Require clients to send x-proxy-key for /v1.
PROXY_SHARED_KEY=

# Optional. Allow public clients to proxy their own upstream AgentRouter keys.
ALLOW_DIRECT_UPSTREAM_KEYS=

# Dangerous on public hosts. Keep false/unset unless the service is private.
ALLOW_SERVER_KEY_PROXY=
